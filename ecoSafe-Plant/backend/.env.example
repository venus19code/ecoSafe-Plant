# ==========================================================
# VARIABLES DE ENTORNO - ECOSAFE PLANT
# Copia este archivo como ".env" y ajusta los valores.
# En producción (Render, Railway, etc.) configúralas en el panel del servicio.
# ==========================================================

# Servidor
PORT=5000
DEBUG=True
SECRET_KEY=ecosafe_secret_jwt_key_super_segura_2026
JWT_EXPIRATION_HOURS=24

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecosafe_db

# Opción alternativa: una sola variable con la URL completa
# DATABASE_URL=mysql://usuario:clave@host:3306/ecosafe_db

# MySQL en la nube (Aiven, TiDB Cloud, PlanetScale...)
DB_SSL=False
# Ruta al certificado CA si el proveedor lo exige
# DB_SSL_CA=/ruta/al/ca.pem

# Crear tablas y datos de demostración automáticamente al arrancar
AUTO_INIT_DB=False
