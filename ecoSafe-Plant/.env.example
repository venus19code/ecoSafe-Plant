# ==========================================================
# VARIABLES PARA DOCKER COMPOSE
# Copia este archivo como ".env" (misma carpeta que docker-compose.yml)
#   Copy-Item .env.example .env
# ==========================================================

# --- MySQL ---
# Contraseña del usuario root del contenedor (solo uso local)
MYSQL_ROOT_PASSWORD=rootpass

# Usuario de la aplicación (NO uses root en la app)
DB_USER=ecosafe
DB_PASSWORD=ecosafe123
DB_NAME=ecosafe_db

# Puerto del host para conectarte a MySQL (3307 evita chocar con XAMPP)
MYSQL_PORT=3307

# --- Backend Flask ---
BACKEND_PORT=5000
SECRET_KEY=ecosafe_secret_jwt_key_super_segura_2026
JWT_EXPIRATION_HOURS=24

# true = crea tablas y carga datos semilla/demo si la base está vacía
AUTO_INIT_DB=true

# --- Adminer (visor de la base de datos) ---
ADMINER_PORT=8080

# --- Varios ---
TZ=America/Bogota
